<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="serif"
        android:text="PriceRunner"
        android:textColor="@color/text_charcoal"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="Compare prices instantly"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <!-- Scan Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonScan"
        style="@style/PriceRunner.Button.Outlined"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Scan Barcode"
        app:icon="@android:drawable/ic_menu_camera"
        app:iconGravity="textStart"
        app:iconTint="@color/text_charcoal" />

    <!-- Price List Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonPriceList"
        style="@style/PriceRunner.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="View Prices" />

    <!-- About Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonAbout"
        style="@style/PriceRunner.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="About" />

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5" />

</LinearLayout>